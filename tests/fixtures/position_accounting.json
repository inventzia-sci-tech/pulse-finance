{
  "fixtureVersion": 1,
  "source": "Derived from first principles. NOT captured from the legacy implementation.",
  "assumptions": {
    "multiplier": "Each case declares its own `multiplier` (default \"1\"). The stored signedNotional is UNmultiplied: the multiplier scales the whole realized and unrealized expression, not one term of it. Case multiplied-contract-cl exercises CL at 1000.",
    "arithmetic": "Exact decimal throughout. No intermediate rounding at any step, including notionals and VWAP numerators (D2 open; this is the narrowest defensible choice and the one the identity below requires).",
    "vwapRepresentation": "vwap is reported as a per-unit price. Implementations are expected to carry signed notional internally and divide on read; the fixtures assert the observable per-unit value.",
    "openingBaseline": "openingEquity = openingCash + openingPos * openingVwap, so opening unrealized is zero by construction.",
    "feePolicy": "Fees reduce cash and accumulate in cumulativeFees. They do NOT reduce grossRealizedPnl (D3).",
    "shortVwap": "A short position's vwap is the average price at which it was sold. unrealizedPnl = signedPos * (mark - vwap) therefore gives the correct sign for both directions.",
    "signedNotional": "The accounting source of truth, asserted where a case exercises rounding. unrealizedPnl is (signedPosition * mark - signedNotional) * multiplier - EXACT, never derived from the rounded vwap. Where a case omits signedNotional it equals signedPosition * vwap exactly.",
    "division": "D2: divisions round at scale 12, HALF_EVEN. Only two things divide - the reported vwap, and costRemoved on a PARTIAL reduce. On a close or reversal costRemoved == signedNotional exactly."
  },
  "identity": "netPnl(t) == grossRealizedPnl(t) + unrealizedPnl(t) - cumulativeFees(t), where netPnl(t) = cash(t) + signedPos(t)*mark(t) - openingEquity - cumulativeExternalCashFlow(t)",
